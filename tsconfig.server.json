{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/workers-types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  },
  "include": ["worker-configuration.d.ts", "functions/**/*.ts", "server/**/*.ts", "src/types/portfolio.ts", "src/data/portfolio.ts"]
}

